# 复制这个文件为 .env，然后填入你真实的 key
# 命令：Copy-Item .env.example .env
#
# ⚠️ .env 文件千万不要提交到 GitHub（.gitignore 已经挡住了）
# 泄露的 key 会在几分钟内被爬虫扫到并盗刷

# DeepSeek（推荐首选，便宜 + 中文好 + 兼容 OpenAI 协议）
# 申请地址：https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-在这里填你的key

# ---- 以下按需启用 ----

# 阿里云百炼（通义千问），有免费额度，国内直连
# 申请地址：https://bailian.console.aliyun.com
# DASHSCOPE_API_KEY=sk-xxx

# 硅基流动（聚合平台，注册送额度，一个 key 用很多模型）
# 申请地址：https://siliconflow.cn
# SILICONFLOW_API_KEY=sk-xxx

# 智谱 GLM
# ZHIPU_API_KEY=xxx

# 月之暗面 Kimi
# MOONSHOT_API_KEY=sk-xxx
