# ★ 这个文件很重要：它挡住你的 API Key，防止被 GitHub 爬虫扫到盗刷
.env
.env.*
!.env.example

# ★ PyCharm 自动生成，不需要提交到 git（2026-10-11 加）
.idea/

# Python 虚拟环境（虚拟环境不进 git，用 requirements.txt 重建即可）
# ⚠️ 这一行如果丢了，`git add -A` 会把 .venv 里几万个包文件全提交上去（2026-10-11 真实踩过）
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/

# 编辑器
.vscode/
*.swp

# 数据与产物
*.log
data/
outputs/
.cache/

# Notebook
.ipynb_checkpoints/
